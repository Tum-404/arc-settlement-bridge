APP_NAME="Settlement Bridge"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bridge.example.com

BRIDGE_IMAGE=iad.ocir.io/<tenancy-namespace>/arc-settlement-bridge:<release-tag>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Keep the database service private: do not publish PostgreSQL ports from Compose.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=settlement
DB_USERNAME=settlement_bridge
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Settlement Bridge Configuration
SETTLEMENT_PROVIDER=fake
INVOICE_GATEWAY=fake
SETTLEMENT_ALLOW_UNSIGNED_WEBHOOKS=false

# Circle Arc Testnet Configuration
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_BLOCKCHAIN=ARC-TESTNET
CIRCLE_API_BASE_URL=https://api.circle.com
ARC_WALLET_ID=
ARC_WALLET_ADDRESS=
ARC_USDC_CONTRACT_ADDRESS=
ARC_WEBHOOK_SECRET=

# SolidInvoice API Configuration
SOLIDINVOICE_URL=http://solidinvoice:8765
SOLIDINVOICE_TOKEN=
